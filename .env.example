# Порт сайта
PORT=3000

# Настройки почты (SMTP), чтобы коды приходили на настоящую почту.
# Пример для Gmail: создайте «пароль приложения» в настройках аккаунта Google.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASS=app-password-here
MAIL_FROM="Royou <your-address@gmail.com>"
